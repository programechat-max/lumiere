# LUMIERE backend ortam değişkenleri — bu dosyayı `.env` olarak kopyalayıp doldurun.
# Hiçbir gizli anahtarı GIT'e commit ETMEYİN. `.env` zaten .gitignore'da olmalı.

# ------------------------------------------------------------------
# GENEL
# ------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=true
APP_VERSION=1.0.0

# ------------------------------------------------------------------
# VERİTABANI (PROMPT 1) — boş bırakılırsa SQLite kullanılır (sqlite:///./sql_app.db)
# ------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://lumiere:lumiere_dev_password@localhost:5432/lumiere
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ------------------------------------------------------------------
# JWT / AUTH (PROMPT 2)
# ------------------------------------------------------------------
JWT_SECRET_KEY=DEGISTIR-openssl-rand-hex-32-ile-uret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_CONCURRENT_SESSIONS=3
# ÜRETİMDE (ENVIRONMENT=production) BU DEĞER MUTLAKA true OLMALI (HTTPS zorunlu):
COOKIE_SECURE=false
# COOKIE_DOMAIN=.lumiere-coaching.com

# İlk admin hesabını otomatik yükseltmek için (virgülle ayrılmış e-postalar):
ADMIN_BOOTSTRAP_EMAILS=

# ------------------------------------------------------------------
# CORS (kritik güvenlik ayarı — PROMPT 8) — virgülle ayrılmış izinli origin listesi
# ------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,ionic://localhost

# ------------------------------------------------------------------
# REDIS / CELERY (PROMPT 5) — boş bırakılırsa görevler senkron (eager) çalışır
# ------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# ------------------------------------------------------------------
# AWS S3 DOSYA DEPOLAMA (PROMPT 4) — boş bırakılırsa yerel disk fallback kullanılır
# ------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# S3_BUCKET_NAME=lumiere-user-uploads
# S3_KMS_KEY_ID=
# CLOUDFRONT_DOMAIN=

# ------------------------------------------------------------------
# STRIPE FATURALANDIRMA (PROMPT 3) — boş bırakılırsa billing uçları 503 döner
# ------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_ANNUAL=price_...
# STRIPE_PRICE_COACHING=price_...
TRIAL_PERIOD_DAYS=7
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# SENTRY / GÖZLEMLENEBİLİRLİK (PROMPT 7) — boş bırakılırsa devre dışı
# ------------------------------------------------------------------
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_TRACES_SAMPLE_RATE=0.05

# ------------------------------------------------------------------
# APNs / iOS PUSH (PROMPT 9) — boş bırakılırsa push gönderimi no-op olur
# ------------------------------------------------------------------
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=TEAM123456
# APNS_AUTH_KEY_PATH=/secure/path/AuthKey_ABC123DEFG.p8
# APNS_BUNDLE_ID=com.lumiere.coaching
APNS_USE_SANDBOX=true

# ------------------------------------------------------------------
# HIZ SINIRLAMA (PROMPT 6)
# ------------------------------------------------------------------
RATE_LIMIT_FREE_PER_MINUTE=10
RATE_LIMIT_PREMIUM_PER_MINUTE=100
RATE_LIMIT_IP_PER_MINUTE=1000
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ------------------------------------------------------------------
# MEVCUT AI ENTEGRASYONU (değişmedi)
# ------------------------------------------------------------------
# GEMINI_API_KEY=...
